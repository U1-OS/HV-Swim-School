# Copy this file to .env and fill in values only on the deployment server.
# Never commit or place real credentials in browser JavaScript.

HV_APP_ENV=development
HV_SESSION_SECRET=replace-with-a-long-random-production-secret
HV_PUBLIC_URL=http://localhost:8765

# Existing HV Swim Xero organisation — create an OAuth app in developer.xero.com.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8765/api/integrations/xero/callback
XERO_SYNC_ENABLED=false
XERO_EARNINGS_RATE_ID=

# Shopify Headless / Storefront connection.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-04

# Printify POD production. Connect Printify to the Shopify store first.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Optional pool sensor adapter. Manual daily verification remains the default.
POOL_SENSOR_URL=
POOL_SENSOR_TOKEN=

# Optional communications providers for the production deployment.
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

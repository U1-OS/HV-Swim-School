# Copy this file to .env and fill in values only on the deployment server.
# Never commit or place real credentials in browser JavaScript.

HV_APP_ENV=development
HV_SESSION_SECRET=replace-with-a-long-random-production-secret
# Separate 32+ character random key for authenticated encryption of medical, allergy,
# medication, emergency-contact, learning-support and provider OAuth token fields. Never
# reuse the session key. Legacy integration-token records are migrated to this key at startup.
HV_DATA_ENCRYPTION_KEY=replace-with-a-separate-random-data-encryption-key
HV_PUBLIC_URL=http://localhost:8765
# Preview only. Use an absolute path on an encrypted, backed-up persistent volume.
# Production must replace SQLite with managed PostgreSQL; this path still stores private
# association artwork unless that storage is moved to a private object-store adapter.
HV_DATA_DIR=/absolute/path/to/private/hv-swim-data

# First production start only: creates the initial management account in an empty database.
# Remove both values immediately after the first successful start.
HV_BOOTSTRAP_ADMIN_EMAIL=
HV_BOOTSTRAP_ADMIN_PASSWORD=
HV_BOOTSTRAP_ADMIN_NAME=HV Swim Admin

# Family account sign-in. Create an OAuth web client in Google Cloud and a
# Services ID in Apple Developer. These secrets stay server-side; the buttons
# remain visibly unavailable until the matching provider is fully configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/api/auth/oauth/google/callback

APPLE_CLIENT_ID=
# Generate and rotate this server-side client secret from the Apple Developer
# team ID, key ID and private .p8 key. Do not place the .p8 key in this project.
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://localhost:8765/api/auth/oauth/apple/callback

# Existing HV Swim Xero organisation — create an OAuth app in developer.xero.com.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8765/api/integrations/xero/callback
# Final outbound switch. Lesson invoices can be sent only as Xero DRAFT invoices after
# management approval, complete contact mapping and the reviewed account/tax settings below.
# Payroll transmission remains separately hard-locked until account-specific pay periods and
# idempotent export tracking have been implemented and reviewed.
XERO_SYNC_ENABLED=false
XERO_EARNINGS_RATE_ID=
# Confirm these three values with the HV Swim bookkeeper/accountant. The website never
# guesses GST treatment or a chart-of-accounts code.
XERO_LESSON_ACCOUNT_CODE=
XERO_LESSON_TAX_TYPE=
# Xero accepts Exclusive, Inclusive or NoTax. Choose the reviewed organisation setting.
XERO_LINE_AMOUNT_TYPE=

# Explicit owner approval after product and sandbox acceptance; default remains locked.
HV_COMMERCE_LIVE_APPROVED=false

# Shopify Headless / Storefront connection.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_CACHE_SECONDS=300

# Printify POD production. Connect Printify to the Shopify store first.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Optional pool sensor adapter. Manual daily verification remains the default.
POOL_SENSOR_URL=
POOL_SENSOR_TOKEN=

# Commercial production weather feed. Open-Meteo's free endpoint is development-only.
OPEN_METEO_API_KEY=
WEATHER_CACHE_SECONDS=600

# Provider credentials alone do not send messages. Email/SMS/push adapters and consent
# workflows must be implemented and tested before these channels can be enabled.
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Account invitations and password-recovery email (SMTP over TLS).
# This adapter covers account links; general support, SMS and push remain separate.
HV_SMTP_HOST=
HV_SMTP_PORT=465
HV_SMTP_USER=
HV_SMTP_PASSWORD=
HV_SMTP_FROM=

# The isolated preview launcher sets this false so local previews never load .env.
HV_LOAD_DOTENV=true

# PostgreSQL adapter (optional locally; managed production host must use verified TLS).
HV_DATABASE_URL=
# Separate one-off migration target, supplied privately; must point at an empty schema.
HV_MIGRATION_TARGET_URL=
# Explicit owner approval required before any email can leave the application.
HV_EMAIL_LIVE_APPROVED=false
# Encrypted recovery bundles; supply privately at runtime, never commit a real passphrase.
HV_BACKUP_PASSPHRASE=

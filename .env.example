# Copy this file to .env and fill in values only on the deployment server.
# Never commit or place real credentials in browser JavaScript.

HV_APP_ENV=development
HV_SESSION_SECRET=replace-with-a-long-random-production-secret
HV_PUBLIC_URL=http://localhost:8765

# First production start only: creates the initial management account in an empty database.
# Remove both values immediately after the first successful start.
HV_BOOTSTRAP_ADMIN_EMAIL=
HV_BOOTSTRAP_ADMIN_PASSWORD=
HV_BOOTSTRAP_ADMIN_NAME=HV Swim Admin

# Existing HV Swim Xero organisation — create an OAuth app in developer.xero.com.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8765/api/integrations/xero/callback
# Reserved launch switch. Payroll transmission remains hard-locked until account-specific
# pay periods and idempotent export tracking have been implemented and reviewed.
XERO_SYNC_ENABLED=false
XERO_EARNINGS_RATE_ID=

# Shopify Headless / Storefront connection.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_CACHE_SECONDS=300

# Printify POD production. Connect Printify to the Shopify store first.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Optional pool sensor adapter. Manual daily verification remains the default.
POOL_SENSOR_URL=
POOL_SENSOR_TOKEN=

# Commercial production weather feed. Open-Meteo's free endpoint is development-only.
OPEN_METEO_API_KEY=
WEATHER_CACHE_SECONDS=600

# Provider credentials alone do not send messages. Email/SMS/push adapters and consent
# workflows must be implemented and tested before these channels can be enabled.
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# TLS certificate paths are host-specific — use Let's Encrypt, a commercial cert or staging mkcert.
# Replace staging.example.invalid before any public launch.

upstream hv_swim_app {
    server 172.28.0.3:8000;
}

server {
    listen 443 ssl;
    http2 on;
    server_name staging.example.invalid;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 6m;

    location / {
        proxy_pass http://hv_swim_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

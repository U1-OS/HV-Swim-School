# Same-host nginx → loopback Uvicorn (see deploy/systemd/hv-swim.service.example).
# Set HV_TRUSTED_PROXIES=127.0.0.1 and --forwarded-allow-ips=127.0.0.1 in the service env.

upstream hv_swim_app {
    server 127.0.0.1:8000;
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.example.invalid;

    ssl_certificate     /etc/ssl/certs/hv-swim-fullchain.pem;
    ssl_certificate_key /etc/ssl/private/hv-swim.key;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 6m;

    location / {
        proxy_pass http://hv_swim_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

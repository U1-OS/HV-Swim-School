# Copy to deploy/.env on the server (never commit). Values below are placeholders only.

HV_APP_ENV=production
HV_LOAD_DOTENV=false
HV_PUBLIC_URL=https://www.example.invalid
HV_DATA_DIR=/data

HV_SESSION_SECRET=replace-with-a-long-random-production-secret
HV_DATA_ENCRYPTION_KEY=replace-with-a-separate-random-data-encryption-key

# Must match the reverse proxy address Uvicorn sees (127.0.0.1 when nginx is on the same host).
HV_TRUSTED_PROXIES=127.0.0.1
HV_FORWARDED_ALLOW_IPS=127.0.0.1

HV_UVICORN_HOST=127.0.0.1
HV_UVICORN_PORT=8000

XERO_SYNC_ENABLED=false
